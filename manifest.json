{
  "manifest_version": 3,
  "name": "QC Smart Reader",
  "description": "Capture research, verify AI claims against exact quotes, and save an auditable local Markdown + SQLite vault.",
  "version": "0.9.1",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "QC Smart Reader",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "downloads",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
